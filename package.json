{
  "name": "kweri",
  "version": "0.2.1",
  "license": "MIT",
  "author": {
    "name": "Jeremiah Uchenna",
    "url": "https://github.com/ucejtech"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kweri-gen": "./cli/generate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-version.js",
    "build": "npm run prebuild && tsc -p tsconfig.build.json",
    "dev": "npm run prebuild && tsc -p tsconfig.build.json --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "pack": "bun run build && npm pack",
    "prepublishOnly": "bun run build",
    "version": "changeset version && node scripts/generate-version.js",
    "release": "bun run build && changeset publish"
  },
  "files": [
    "dist",
    "cli",
    "logo",
    "tsconfig.build.json"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "typed-openapi": "^2.2.4",
    "@apidevtools/swagger-parser": "^12.1.0",
    "ajv": "^8.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "@types/json-schema": "^7.0.15",
    "typescript": "^5",
    "vue": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
